@model MachineWeb.Models.HomeDto
@{
    ViewData["Title"] = "Home Page";
}

<style>
    .banner-part{height:400px;background-size:cover !important;}
</style>

<!--=====================================
                   BANNER PART START
       =======================================-->
<section class="home-classic-slider slider-arrow">
    <div class="banner-part" style="background: url(images/home/classic/t1.jpg) no-repeat center;">
     
    </div>
    <div class="banner-part" style="background: url(images/home/classic/02.jpg) no-repeat center;">
       
    </div>
    <div class="banner-part" style="background: url(images/home/classic/03.jpg) no-repeat center;">
        
    </div>
</section>


<section class="section category-part main-category" style="background:#e9f4f0;">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="section-heading">
                    <h2>our categories</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="category-slider slider-arrow">
                    @if (Model != null)
                    {
                        @if (Model.categoryDataResponses != null)
                        {
                            foreach (var category in Model.categoryDataResponses)
                            {
                                <div class="category-wrap">
                                    <div class="category-media">
                                        <img src="@category.CategoryImage" alt="category">
                                        <div class="category-overlay">
                                            <a href='/productlist?CategoryGuid=@category.CategoryGuid'><i class="fas fa-link"></i></a>
                                        </div>
                                    </div>
                                    <div class="category-meta">
                                        <h6>@category.CategoryName</h6>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
       
    </div>
</section>


 <section class="inner-section about-company">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <div class="about-content">
                            <h2>Our Motive is to Provide Best for Those Who Deserve</h2>
                    <p>Smart, User-Friendly and Affordable Fruit And Vegetable Processing Plant and Machine, Food Processing Machine, Food Processing Equipment, High Speed Shear Mixture Pump, etc.</p>
                        </div>
                        <ul class="about-list">
                            <li>
                                <h3>34785</h3>
                                <h6>registered users</h6>
                            </li>
                            <li>
                                <h3>2623</h3>
                                <h6>per day visitors</h6>
                            </li>
                            <li>
                                <h3>189</h3>
                                <h6>total products</h6>
                            </li>
                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <div class="about-img">
                            <img src="images/about/01.jpg" alt="about">
                            <img src="images/about/02.jpg" alt="about">
                            <img src="images/about/03.jpg" alt="about">
                            <img src="images/about/04.jpg" alt="about">
                        </div>
                    </div>
                </div>
            </div>
        </section>


<!--=====================================
            PROMOTION PART START
=======================================-->

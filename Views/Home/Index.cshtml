<section class="section countdown-part">
    <div class="container">

        <div id="machineCarousel" class="carousel slide" data-bs-ride="carousel">

            <div class="carousel-inner">

                <!-- SLIDE 1 -->
                <div class="carousel-item active">
                    <div class="row align-items-center">
                        <div class="col-lg-6">
                            <div class="countdown-content">
                                <h3>Vacuum Filler Double Head Machine</h3>
                                <p>
                                    High-performance filling solution for liquid and semi-liquid
                                    products with food-grade stainless steel construction.
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="countdown-img">
                                <img src="~/images/img13.png" class="img-fluid" alt="Machine 1">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SLIDE 2 -->
                <div class="carousel-item">
                    <div class="row align-items-center">
                        <div class="col-lg-6">
                            <div class="countdown-content">
                                <h3>Automatic Liquid Filling Machine</h3>
                                <p>
                                    Fully automatic system designed for speed, precision,
                                    and hygienic production.
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="countdown-img">
                                <img src="~/images/img14.png" class="img-fluid" alt="Machine 2">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SLIDE 3 -->
                <div class="carousel-item">
                    <div class="row align-items-center">
                        <div class="col-lg-6">
                            <div class="countdown-content">
                                <h3>Semi Automatic Paste Filling Machine</h3>
                                <p>
                                    Ideal for viscous products like sauce, cream and ketchup
                                    with easy maintenance.
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="countdown-img">
                                <img src="~/images/img15.png" class="img-fluid" alt="Machine 3">
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- LEFT / RIGHT ARROWS -->
            <button class="carousel-control-prev" type="button"
                    data-bs-target="#machineCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>

            <button class="carousel-control-next" type="button"
                    data-bs-target="#machineCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>

        </div>

    </div>
</section>

<!--=====================================
            COUNTDOWN PART END
=======================================-->
<!--=====================================
<!--=====================================
            PROMOTION PART END
=======================================-->


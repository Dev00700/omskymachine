<!DOCTYPE html>
<html lang="en">
<head>
    <!--=====================================
                META TAG PART START
    =======================================-->
    <!-- REQUIRE META -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- TEMPLATE META -->
    <!-- WEBPAGE TITLE -->
    <title>Index Home - </title>

    <!--=====================================
                CSS LINK PART START
    =======================================-->
    <!-- FAVICON -->
    <link rel="icon" href="~/images/logo.png">

    <!-- FONTS -->
    <link rel="stylesheet" href="~/fonts/flaticon/flaticon.css">
    <link rel="stylesheet" href="~/fonts/icofont/icofont.min.css">
    <link rel="stylesheet" href="~/fonts/fontawesome/fontawesome.min.css">

    <!-- VENDOR -->
    <link rel="stylesheet" href="~/vendor/venobox/venobox.min.css">
    <link rel="stylesheet" href="~/vendor/slickslider/slick.min.css">
    <link rel="stylesheet" href="~/vendor/niceselect/nice-select.min.css">
    <link rel="stylesheet" href="~/vendor/bootstrap/bootstrap.min.css">
       <link rel="stylesheet" href="css/about.css">

    <!-- CUSTOM -->
    <link rel="stylesheet" href="~/css/main.css">
    <link rel="stylesheet" href="~/css/index.css">
    <!--=====================================
                CSS LINK PART END
    =======================================-->
</head>

<body>

    <div class="backdrop"></div>
    <a class="backtop fas fa-arrow-up" href="#"></a>


  
    <!--=====================================
                HEADER PART START
    =======================================-->
    <header class="header-part">
        <div class="container">
            <div class="header-content header-flex">

                <!-- LEFT : Logo -->
                <div class="header-left">
                    <div class="header-media-group">
                        <button class="header-user">
                            <img src="/images/menu.png" alt="menu">
                        </button>
                    </div>

                    <a class="header-logo" href=@Url.Action("Index", "Home")>
                        <img src="/images/logo.png" alt="logo">
                    </a>
                </div>

                <!-- CENTER : Menu -->
                <nav class="navbar-part">
                    <ul class="navbar-list">
                        <li class="navbar-item">
                            <a class="navbar-link" href=@Url.Action("Index", "Home")>Home</a>
                        </li>

                        <li class="navbar-item">
                            <a class="navbar-link" href=@Url.Action("AboutUs", "Home")>About Us</a>
                        </li>

                        <li class="navbar-item dropdown">
                            <a class="navbar-link dropdown-arrow" href="javascript:void(0);">
                                Our Category
                            </a>

                            @await Component.InvokeAsync("MainCategory")

                            
                        </li>

                        <li class="navbar-item">
                            <a class="navbar-link" href=@Url.Action("Blog", "Blog")>Blog</a>
                        </li>

                        <li class="navbar-item">
                            <a class="navbar-link" href=@Url.Action("Contact", "Home")>Contact Us</a>
                        </li>
                    </ul>
                </nav>

                <!-- RIGHT : Contact -->
                <div class="header-right">
                    <div class="navbar-info">
                        <i class="icofont-ui-touch-phone"></i>
                        <span>+91 92118 10926</span>
                    </div>

                    <div class="navbar-info">
                        <i class="icofont-ui-email"></i>
                        <span>Info@omskymachines.com</span>
                    </div>
                </div>

            </div>
        </div>
    </header>

    <!--=====================================
                HEADER PART END
    =======================================-->
    <!--=====================================
                NAVBAR PART START
    =======================================-->
   
    <!--=====================================
                NAVBAR PART END
    =======================================-->
 
    
    <!--=====================================
              NAV SIDEBAR PART START
    =======================================-->
    <aside class="nav-sidebar">

        <!-- Header -->
        <div class="nav-header">
            <a href="@Url.Action("Index", "Home")" class="nav-logo">
                <img src="/images/logo.png" alt="logo">
            </a>
            <button class="nav-close">
                <i class="icofont-close"></i>
            </button>
        </div>

        <!-- Content -->
        <div class="nav-content">

            <!-- Menu -->
            <ul class="nav-list">

                <li>
                    <a class="nav-link" href=@Url.Action("Index", "Home")>
                        <i class="icofont-home"></i>
                        <span>Home</span>
                    </a>
                </li>

                <li>
                    <a class="nav-link" href=@Url.Action("AboutUs", "Home")>
                        <i class="icofont-info-circle"></i>
                        <span>About Us</span>
                    </a>
                </li>

               @*  <li class="nav-dropdown">
                    <a class="nav-link dropdown-arrow" href="#">
                        <i class="icofont-box"></i>
                        <span>Our Category</span>
                    </a>

                    @await Component.InvokeAsync("MainCategory")
                </li> *@

                <li class="navbar-item dropdown">
                    <a class="navbar-link dropdown-arrow" href="javascript:void(0);">
                        Our Category
                    </a>

                     @await Component.InvokeAsync("MainCategory")

                   
                </li>

                <li>
                    <a class="nav-link" href=@Url.Action("Index1", "Blog")>
                        <i class="icofont-book-alt"></i>
                        <span>Blog</span>
                    </a>
                </li>

                <li>
                    <a class="nav-link" href=@Url.Action("Contact", "Home")>
                        <i class="icofont-contacts"></i>
                        <span>Contact Us</span>
                    </a>
                </li>

            </ul>

            <!-- Contact Info -->
            <div class="nav-info-group">

                <div class="nav-info">
                    <i class="icofont-ui-touch-phone"></i>
                    <div>
                        <small>Call Us</small>
                        <span>+91 92118 10926</span>
                    </div>
                </div>

                <div class="nav-info">
                    <i class="icofont-ui-email"></i>
                    <div>
                        <small>Email Us</small>
                        <span>Info@omskymachines.com</span>
                    </div>
                </div>

            </div>

            <!-- Footer -->
            <div class="nav-footer">
                <p>© @DateTime.Now.Year All Rights Reserved by <a href="#">Omskymachine</a></p>
            </div>

        </div>
    </aside>

   
    <!--=====================================
                PRODUCT VIEW END
    =======================================-->


    <div>
            @RenderBody()
        <a href="tel:919876543210"
           class="call-fixed"
           aria-label="Call Us">
            <img src="/images/call.png" alt="Call Now">
        </a>
        <a href="https://wa.me/919876543210?text=Hello%20I%20want%20to%20know%20more"
           class="whatsapp-fixed"
           target="_blank"
           aria-label="Chat on WhatsApp">
            <img src="/images/whatsapp.jfif" alt="WhatsApp Chat">
        </a>
       
    </div>

    <div class="modal fade" id="product-view">
        <div class="modal-dialog">
            <div class="modal-content">
                <button class="modal-close icofont-close" data-bs-dismiss="modal"></button>
                <div class="product-view">
                    <div class="row" style="padding:2%">
                        <div class="col-md-12 col-lg-12">
                            
                                <h4>Enquiry </h4>
                                <div class="form-group">
                                    <div class="form-input-group">
                                        <input class="form-control" type="text" placeholder="Your Name" id="txtname" />
                                        <i class="icofont-user-alt-3"></i>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="form-input-group">
                                        <input class="form-control" type="text" placeholder="Your Email" id="txtemail" />
                                        <i class="icofont-email"></i>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="form-input-group">
                                        <input class="form-control" type="text" placeholder="Your Subject" id="txtsubject" />
                                        <i class="icofont-book-mark"></i>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="form-input-group">
                                        <textarea class="form-control" placeholder="Your Message" id="txtmessage"></textarea>
                                        <i class="icofont-paragraph"></i>
                                    </div>
                                </div>
                                <button type="button" class="form-btn-group" onclick="SendEnquiry()">
                                    <i class="fas fa-envelope"></i>
                                    <span>send message</span>
                                </button>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
   
    <footer class="footer-part">
        <div class="container">
            <div class="row">
                <div class="col-sm-6 col-xl-3">
                    <div class="footer-widget">
                        <a class="footer-logo" href="#">
                            <img src="/images/logo.png" alt="logo">
                        </a>
                        <p class="footer-desc">Omsky Processpack Solution is a leading manufacturer and supplier of food processing and packaging machinery, delivering reliable solutions for juice, pulp, ketchup, and liquid packaging industries.</p>
                        <ul class="footer-social">
                            <li><a class="icofont-facebook" href="#"></a></li>
                            <li><a class="icofont-twitter" href="#"></a></li>
                            <li><a class="icofont-linkedin" href="#"></a></li>
                            <li><a class="icofont-instagram" href="https://www.instagram.com/omskymachine/" target="_blank"></a></li>
                            <li><a class="icofont-pinterest" href="#"></a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="footer-widget contact">
                        <h3 class="footer-title">contact us</h3>
                        <ul class="footer-contact">
                            <li>
                                <i class="icofont-ui-email"></i>
                                <p>
                                    <span>Info@omskymachines.com</span>
                                    <span>Info@omskymachines.com</span>
                                </p>
                            </li>
                            <li>
                                <i class="icofont-ui-touch-phone"></i>
                                <p>
                                    <span>+91 92118 10926</span>
                                    <span>+91 81301 23485</span>
                                </p>
                            </li>
                            <li>
                                <i class="icofont-location-pin"></i>
                                <p>
                                    Omsky Processpack solution
                                    Badli industrial area
                                    Khasra no 902  Near RD Farm Delhi 110042
                                </p>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="footer-widget">
                        <h3 class="footer-title">Our Machines / Products</h3>
                        <div class="footer-links">
                            <ul>
                                <li>Juice Processing Plant</li>
                                <li>Fruit Pulper Machine</li>
                                <li>Tomato Ketchup Processing Line</li>
                              
                            </ul>
                            <ul>
                                <li>Vacuum Filler Machine</li>
                                <li>Bottle Filling & Packaging Machine</li>
                                <li>Customized Food Processing Solutions</li>
                               
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="footer-widget">
                        <h3 class="footer-title">Industries We Serve</h3>
                        <div class="footer-links">
                        <ul>
                            <li>Beverage & Juice Industry</li>
                            <li>Food & Condiment Industry</li>
                            <li>FMCG Packaging</li>
                            <li>Small & Medium Food Units</li>

                        </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="footer-bottom">
                        <p class="footer-copytext">&copy;@DateTime.Now.Year  All Copyrights Reserved by Omskymachine</p>
                        <div class="footer-card">
                             Design & developed by DIDS
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>
   
   


    <script src="~/vendor/bootstrap/jquery-1.12.4.min.js"></script>
    <script src="~/vendor/bootstrap/popper.min.js"></script>
    <script src="~/vendor/bootstrap/bootstrap.min.js"></script>
    <script src="~/vendor/countdown/countdown.min.js"></script>
    <script src="~/vendor/niceselect/nice-select.min.js"></script>
    <script src="~/vendor/slickslider/slick.min.js"></script>
    <script src="~/vendor/venobox/venobox.min.js"></script>

    <!-- CUSTOM -->
    <script src="~/js/nice-select.js"></script>
    <script src="~/js/countdown.js"></script>
    <script src="~/js/accordion.js"></script>
    <script src="~/js/venobox.js"></script>
    <script src="~/js/slick.js"></script>
    <script src="~/js/main.js"></script>

    <script src="~/js/contactus.js?var= @DateTime.Now"></script>
    <script>
        document.querySelector(".header-user").addEventListener("click", function () {
            document.querySelector(".navbar-part").classList.toggle("active");
        });
    </script>

   


</body>
</html>
